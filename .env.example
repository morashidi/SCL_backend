# Mongo connection string. Local mongod or an Atlas cluster, either works.
MONGO_URI=mongodb://localhost:27017/scl

# Used to sign access and refresh tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Changing it logs everyone out.
JWT_SECRET=

PORT=5000

# Token lifetimes in seconds: 1 hour and 30 days.
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
