{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mocha: All Tests",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/mocha/lib/cli/cli.js",
      "args": [
        "--timeout",
        "0",
        "--colors"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Mocha: Current File",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/mocha/lib/cli/cli.js",
      "args": [
        "--no-config",
        "--timeout",
        "0",
        "--colors",
        "--exit",
        "--file",
        "${workspaceFolder}/test/setup.js",
        "${file}"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
